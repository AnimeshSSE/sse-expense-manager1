# ===========================================
# S.S. Electricals — Expense Manager
# Environment Variables Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control
# ===========================================

# --- DATABASE (Required) ---

# Turso (libSQL) — Production:
DATABASE_URL="libsql://your-database-name.your-region.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token-here"

# Local development (SQLite) — Uncomment below and comment out Turso:
# DATABASE_URL="file:db/custom.db"
# DATABASE_AUTH_TOKEN=""

# --- APP (Optional) ---

# Override default Next.js port (default: 3000)
# PORT=3000

# --- EMAIL (Required for Daily Report) ---

# Gmail address for sending daily reports
SMTP_EMAIL="your-email@gmail.com"

# Gmail App Password (generate from Google Account → Security → 2FA → App Passwords)
SMTP_PASSWORD="your-gmail-app-password"

# Recipient email address for daily reports (defaults to SMTP_EMAIL if not set)
REPORT_EMAIL="your-email@gmail.com"
