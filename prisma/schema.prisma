generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String   @default("changeme123")
  role       String   @default("EMPLOYEE")
  department String?
  employeeId String?
  phone      String?
  status     String   @default("ACTIVE")
  avatar     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  expenses      Expense[]
  requisitions  Requisition[]
  advances      Advance[]
  approvedExpenses     Expense[]     @relation("ExpenseApprover")
  approvedRequisitions Requisition[] @relation("RequisitionApprover")
  approvedAdvances     Advance[]     @relation("AdvanceApprover")
  auditLogs     AuditLog[]
  preferences   UserPreferences?
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  expenseItems ExpenseItem[]
}

model Expense {
  id             String   @id @default(cuid())
  title          String
  description    String?
  status         String   @default("DRAFT")
  totalAmount    Float    @default(0)
  submittedDate  DateTime?
  userId         String
  department     String?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  paymentDate    DateTime?
  paymentRef     String?
  siteId         String?
  clientId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id])
  approvedBy User?         @relation("ExpenseApprover", fields: [approvedById], references: [id])
  site       Site?         @relation(fields: [siteId], references: [id])
  client     Client?       @relation(fields: [clientId], references: [id])
  items      ExpenseItem[]
  auditLogs  AuditLog[]
}

model ExpenseItem {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        DateTime
  categoryId  String
  expenseId   String
  receiptUrl  String?
  notes       String?
  createdAt   DateTime @default(now())

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  expense  Expense         @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model Requisition {
  id             String   @id @default(cuid())
  title          String
  description    String?
  status         String   @default("DRAFT")
  totalAmount    Float    @default(0)
  submittedDate  DateTime?
  userId         String
  department     String?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  vendorName     String?
  deliveryDate   DateTime?
  siteId         String?
  clientId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id])
  approvedBy User?             @relation("RequisitionApprover", fields: [approvedById], references: [id])
  site       Site?             @relation(fields: [siteId], references: [id])
  client     Client?           @relation(fields: [clientId], references: [id])
  items      RequisitionItem[]
  auditLogs  AuditLog[]
}

model RequisitionItem {
  id            String   @id @default(cuid())
  description   String
  quantity      Int
  unitPrice     Float
  totalAmount   Float
  urgency       String   @default("NORMAL")
  itemCode      String?
  notes         String?
  requisitionId String
  createdAt     DateTime @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
}

model Advance {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  status             String   @default("DRAFT")
  amount             Float
  purpose            String
  submittedDate      DateTime?
  expectedReturnDate DateTime?
  userId             String
  department         String?
  approvedById       String?
  approvedAt         DateTime?
  rejectedReason     String?
  settlementAmount   Float?
  settlementDate     DateTime?
  siteId             String?
  clientId           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  approvedBy User?       @relation("AdvanceApprover", fields: [approvedById], references: [id])
  site       Site?       @relation(fields: [siteId], references: [id])
  client     Client?     @relation(fields: [clientId], references: [id])
  auditLogs  AuditLog[]
}

model AuditLog {
  id            String   @id @default(cuid())
  action        String
  entityType    String
  entityId      String
  userId        String
  details       String?
  createdAt     DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id])
  expense       Expense?     @relation(fields: [expenseId], references: [id])
  expenseId     String?
  requisition   Requisition? @relation(fields: [requisitionId], references: [id])
  requisitionId String?
  advance       Advance?     @relation(fields: [advanceId], references: [id])
  advanceId     String?
}

model Site {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  address   String?
  city      String?
  state     String?
  pincode   String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses     Expense[]
  requisitions Requisition[]
  advances     Advance[]
}

model Client {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses     Expense[]
  requisitions Requisition[]
  advances     Advance[]
}

model UserPreferences {
  id            String   @id @default(cuid())
  userId        String   @unique
  tableSettings String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}
