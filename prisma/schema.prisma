generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = "file:./db/custom.db"
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  ACCOUNTANT
  STOCK_MANAGER
  USER
}

enum ExpenseStatus {
  PENDING
  ACCOUNTANT_APPROVED
  ADMIN_APPROVED
  REJECTED
  RETURNED
  PAID
}

enum RequisitionStatus {
  PENDING
  STOCK_MANAGER_APPROVED
  ADMIN_APPROVED
  REJECTED
  RETURNED
  ORDERED
  RECEIVED
}

enum PaymentMethod {
  CASH
  UPI
  CREDIT
  OFFICE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CategoryType {
  EXPENSE
  REQUISITION
  BOTH
}

enum AdvanceStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  RETURNED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  HALF_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ==================== MODELS ====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  token        String?  @unique
  tokenExpiry  DateTime?
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expenses             Expense[]
  requisitions         Requisition[]
  advances             Advance[]
  auditLogs            AuditLog[]
  comments             Comment[]
  accountantApprovals  Expense[]    @relation("AccountantApprovals")
  adminExpenseApprovals Expense[]    @relation("AdminExpenseApprovals")
  adminMirApprovals    Requisition[] @relation("AdminMirApprovals")
  stockMgrApprovals    Requisition[] @relation("StockMgrApprovals")
  advanceAcctApprovals  Advance[]    @relation("AdvanceAcctApprovals")
  advanceAdminApprovals Advance[]    @relation("AdvanceAdminApprovals")
  advancePaidApprovals  Advance[]    @relation("AdvancePaidBy")
  employee              Employee?
  leaveApprovals        Leave[]      @relation("LeaveApprover")
}

model Client {
  id          String    @id @default(cuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sites    Site[]
}

model Site {
  id          String    @id @default(cuid())
  name        String
  clientId    String
  location    String?
  description String?
  budget      Float     @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  requisitions Requisition[]
  advances    Advance[]

  @@index([clientId])
  @@index([name])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  type        CategoryType @default(BOTH)
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  expenses Expense[]
  @@index([type])
}

model Expense {
  id                     String        @id @default(cuid())
  siteId                 String
  categoryId             String
  userId                 String
  amount                 Float
  description            String
  expenseDate            DateTime
  submissionDate         DateTime      @default(now())
  sellerName             String?
  invoiceNumber          String?
  paymentMethod          PaymentMethod @default(CASH)
  status                 ExpenseStatus @default(PENDING)
  receiptUrl             String?
  receiptFileName        String?
  notes                  String?
  accountantApprovedById String?
  accountantApprovedAt   DateTime?
  adminApprovedById      String?
  adminApprovedAt        DateTime?
  rejectionReason        String?
  returnReason           String?
  isLateSubmission       Boolean       @default(false)
  daysLate               Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  site                   Site          @relation(fields: [siteId], references: [id])
  category               Category      @relation(fields: [categoryId], references: [id])
  user                   User          @relation(fields: [userId], references: [id])
  accountantApprovedBy   User?         @relation("AccountantApprovals", fields: [accountantApprovedById], references: [id])
  adminApprovedBy        User?         @relation("AdminExpenseApprovals", fields: [adminApprovedById], references: [id])

  @@index([siteId])
  @@index([categoryId])
  @@index([userId])
  @@index([status])
  @@index([expenseDate])
  @@index([userId, status])
  @@index([siteId, status])
  @@index([isLateSubmission, createdAt])
}

model Requisition {
  id                      String             @id @default(cuid())
  siteId                  String
  userId                  String
  title                   String
  description             String?
  requiredDate            DateTime
  priority                Priority           @default(MEDIUM)
  status                  RequisitionStatus  @default(PENDING)
  totalAmount             Float              @default(0)
  notes                   String?
  attachmentUrl           String?
  attachmentName          String?
  stockManagerApprovedById String?
  stockManagerApprovedAt  DateTime?
  adminApprovedById       String?
  adminApprovedAt         DateTime?
  rejectionReason         String?
  returnReason            String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  site                    Site               @relation(fields: [siteId], references: [id])
  user                    User               @relation(fields: [userId], references: [id])
  boqItems                BOQItem[]
  stockManagerApprovedBy  User?              @relation("StockMgrApprovals", fields: [stockManagerApprovedById], references: [id])
  adminApprovedBy         User?              @relation("AdminMirApprovals", fields: [adminApprovedById], references: [id])

  @@index([siteId])
  @@index([userId])
  @@index([status])
  @@index([siteId, status])
  @@index([userId, status])
}

model BOQItem {
  id            String   @id @default(cuid())
  requisitionId String
  itemName      String
  description   String?
  quantity      Float
  unit          String
  unitPrice     Float
  totalPrice    Float
  category      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
}

model Advance {
  id                     String         @id @default(cuid())
  userId                 String
  siteId                 String
  amount                 Float
  purpose                String
  status                 AdvanceStatus  @default(PENDING)
  notes                  String?
  accountantApprovedById String?
  accountantApprovedAt   DateTime?
  adminApprovedById      String?
  adminApprovedAt        DateTime?
  paidById               String?
  paidAt                 DateTime?
  rejectionReason        String?
  returnReason           String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  user                   User           @relation(fields: [userId], references: [id])
  site                   Site           @relation(fields: [siteId], references: [id])
  accountantApprovedBy   User?          @relation("AdvanceAcctApprovals", fields: [accountantApprovedById], references: [id])
  adminApprovedBy        User?          @relation("AdvanceAdminApprovals", fields: [adminApprovedById], references: [id])
  paidBy                 User?          @relation("AdvancePaidBy", fields: [paidById], references: [id])

  @@index([userId])
  @@index([siteId])
  @@index([status])
  @@index([userId, status])
  @@index([siteId, status])
}

model Comment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  userId     String
  content    String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType])
  @@index([entityId])
  @@index([userId])
}

model Employee {
  id            String   @id @default(cuid())
  userId        String   @unique
  employeeCode  String   @unique
  designation   String
  department    String?
  phone         String?
  address       String?
  joiningDate   DateTime @default(now())
  baseSalary    Float    @default(0)
  bankAccount   String?
  bankName      String?
  bankIfsc      String?
  panNumber     String?
  aadhaarNumber String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  leaves        Leave[]

  @@index([userId])
  @@index([employeeCode])
  @@index([designation])
}

model Leave {
  id              String       @id @default(cuid())
  employeeId      String
  type            LeaveType    @default(CASUAL)
  startDate       DateTime
  endDate         DateTime
  totalDays       Float        @default(1)
  reason          String?
  status          LeaveStatus  @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy      User?        @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([employeeId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  oldValues  String?
  newValues  String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
